#!/usr/bin/env bash
set -euo pipefail
hub_dir="$(cd "$(dirname "$0")/.." && pwd)"
site_dir="${SHOWCASE_SITE_DIR:-$(dirname "$hub_dir")/website-codex-showcase}"
runtime_dir="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin"
if ! command -v node >/dev/null 2>&1 && [ -x "$runtime_dir/node" ]; then
  export PATH="$runtime_dir:$PATH"
fi
command -v node >/dev/null 2>&1 || { echo 'Node.js 22.13+ is required.' >&2; exit 1; }
export SHOWCASE_OUT_DIR="$site_dir/projects/football-journalism"
test -f "$site_dir/children.html" || { echo 'SHOWCASE_SITE_DIR must be the Toucan site checkout.' >&2; exit 1; }
cd "$hub_dir"
# Existing hub files and build outputs are never replaced or removed.
node node_modules/vite/bin/vite.js build --config vite.showcase.config.ts --configLoader runner
node "$site_dir/scripts/check-showcase-static.mjs"
